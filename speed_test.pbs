#!/bin/bash -l
#PBS -A NLDesignProtein
#PBS -N esmfold_speed_test
#PBS -l walltime=01:00:00
#PBS -l select=1
#PBS -l place=scatter
#PBS -l filesystems=home_fs:flare_fs
#PBS -q debug
#PBS -j oe
#PBS -M bryan.andrews.phd@gmail.com
#PBS -m be

# ---------------------------------------------------------------------------
# Speed test: score 100 SwissProt sequences at several step/loop configs.
# Single-node, single-tile inference — loads model ONCE, then sweeps.
# ---------------------------------------------------------------------------

cd "${PBS_O_WORKDIR:?submit with qsub from the repo root}" || exit 1
set -eo pipefail

module load frameworks

# ---------------------------------------------------------------------------
# Environment — uses a dedicated venv layered on top of the frameworks module.
# To create it (once, from a login node):
#
#   module load frameworks
#   python -m venv /flare/NLDesignProtein/bryan/envs/esmfold-env --system-site-packages
#   source /flare/NLDesignProtein/bryan/envs/esmfold-env/bin/activate
#   pip install --ignore-installed 'transformers>=4.57'
#   pip install --no-deps 'esm @ git+https://github.com/Biohub/esm.git@main'
#   pip install biopython biotite cloudpathlib zstd msgpack-numpy pygtrie tenacity brotli
#
# --system-site-packages inherits torch, ipex, oneCCL, etc. from the
# frameworks module.  --no-deps on esm prevents it from pulling a PyPI
# CUDA torch build that would shadow the system XPU torch.
#
# IMPORTANT: transformers must be force-installed so the venv has its
# own copy (pip may skip it if the system version looks sufficient):
#   pip install --ignore-installed 'transformers>=4.57'
# ---------------------------------------------------------------------------
source /flare/NLDesignProtein/bryan/envs/esmfold-env/bin/activate

export ONEAPI_DEVICE_SELECTOR="level_zero:gpu"
export ZE_FLAT_DEVICE_HIERARCHY=FLAT
export HF_HUB_OFFLINE=1

# Enumerate any aten ops silently falling back XPU -> CPU. Those fallbacks
# are both a performance cliff and (for linalg ops) a source of GPU page
# faults on Aurora's compute-runtime; the scorer patches the known ones.
export PYTORCH_DEBUG_XPU_FALLBACK=1

# The frameworks module prepends its site-packages to PYTHONPATH, which
# shadows venv-installed packages (like our newer transformers). Fix by
# putting the venv's site-packages first.
VENV_SITE="$(python -c 'import sysconfig; print(sysconfig.get_path("purelib"))')"
export PYTHONPATH="${VENV_SITE}:${PBS_O_WORKDIR}/src${PYTHONPATH:+:$PYTHONPATH}"

# ---------------------------------------------------------------------------
# Paths — edit these if your layout differs
# ---------------------------------------------------------------------------
ESMFOLD_WEIGHTS="/flare/NLDesignProtein/bryan/models/ESMFold2-Fast"
FASTA="test_sequences.fasta"

# ---------------------------------------------------------------------------
# Banner
# ---------------------------------------------------------------------------
echo "================================================================"
echo "  ESMFold2-Fast speed test"
echo "================================================================"
echo "  job           : ${PBS_JOBID:-<interactive>}  ${PBS_JOBNAME:-}"
echo "  started       : $(date '+%Y-%m-%dT%H:%M:%S%z')"
echo "  user@host     : $(whoami)@$(hostname)"
echo "  repo          : $(pwd)"
echo "  weights       : ${ESMFOLD_WEIGHTS}"
echo "  HF_HUB_OFFLINE: ${HF_HUB_OFFLINE}"
echo "  fasta         : ${FASTA} ($(grep -c '^>' ${FASTA}) sequences)"
echo "  python        : $(which python)"
echo "  torch         : $(python -c 'import torch; print(torch.__version__)')"
echo "  ipex          : $(python -c 'import intel_extension_for_pytorch; print(intel_extension_for_pytorch.__version__)' 2>/dev/null || echo 'not installed')"
echo "  transformers  : $(python -c 'import transformers; print(transformers.__version__, transformers.__file__)')"
echo "  esm           : $(python -c 'import esm; print(esm.__version__, esm.__file__)' 2>/dev/null || echo 'not installed')"
echo "  esmfold2 model: $(python -c 'from esm.models.esmfold2 import EsmFold2Model; print("available")' 2>&1)"
echo "  xpu devices   : $(python -c 'import torch; import intel_extension_for_pytorch; print(torch.xpu.device_count())' 2>/dev/null || echo 'N/A')"
echo "================================================================"
echo ""

# ---------------------------------------------------------------------------
# Run: load model once, sweep step/loop configs
# ---------------------------------------------------------------------------
python - "${ESMFOLD_WEIGHTS}" "${FASTA}" <<'PYEOF'
import sys
import time

model_path, fasta_path = sys.argv[1], sys.argv[2]

# --- parse FASTA ---
sequences = []
with open(fasta_path) as f:
    header, chunks = "", []
    for line in f:
        line = line.strip()
        if line.startswith(">"):
            if chunks:
                sequences.append("".join(chunks))
            header = line
            chunks = []
        elif line:
            chunks.append(line)
    if chunks:
        sequences.append("".join(chunks))

print(f"Loaded {len(sequences)} sequences "
      f"({min(len(s) for s in sequences)}-{max(len(s) for s in sequences)} aa)\n")

# --- load model once ---
import inspect
import torch
from esmfold_scorer import StructureScorer
from esmfold_scorer.scorer import peak_memory_gb

t_load = time.monotonic()
scorer = StructureScorer(
    model_path=model_path,
    device="xpu",
)
t_load = time.monotonic() - t_load
print(f"Model loaded in {t_load:.1f} s")
print(f"Weights resident: {peak_memory_gb(scorer.device):.1f} GiB\n")

# --- diagnostic: what kwargs does this build of esm accept? ---
try:
    print(f"infer_protein{inspect.signature(scorer._model.infer_protein)}\n")
except (TypeError, ValueError) as exc:
    print(f"(could not introspect infer_protein: {exc})\n")


def probe(label, seq, steps, loops):
    """Score one sequence, reporting time, pLDDT range and peak memory."""
    torch.xpu.reset_peak_memory_stats()
    print(f"[{label}] {len(seq)} aa, {steps} steps, {loops} loop(s)...",
          end=" ", flush=True)
    t = time.monotonic()
    r = scorer.score([seq], num_sampling_steps=steps, num_loops=loops)
    print(f"OK  pLDDT={r.mean_plddt:.4f}  pTM={r.per_sequence_ptm[0]:.4f}  "
          f"{time.monotonic() - t:.1f}s  peak={peak_memory_gb(scorer.device):.1f} GiB",
          flush=True)
    return r


# --- staged smoke tests, cheapest first ---
# The full sweep crashed after the short-sequence smoke test passed, so
# probe the memory worst case (longest sequence at the heaviest config)
# BEFORE committing to 100 sequences. Each stage fails fast and tells us
# where the ceiling is instead of aborting mid-sweep.
by_len = sorted(sequences, key=len)
probe("smoke:short", by_len[0], 2, 1)
probe("smoke:long", by_len[-1], 2, 1)
probe("smoke:long-heavy", by_len[-1], 50, 3)
print()

# --- sweep configs ---
configs = [
    (5, 1), (10, 1), (20, 1), (50, 1),
    (5, 3), (10, 3), (20, 3), (50, 3),
]

print(f"{'steps':>5}  {'loops':>5}  {'pLDDT':>8}  {'time (s)':>9}  {'seq/s':>7}  {'s/seq':>7}  {'peak GiB':>8}")
print("-" * 68)

for steps, loops in configs:
    torch.xpu.reset_peak_memory_stats()
    result = scorer.score(sequences, num_sampling_steps=steps, num_loops=loops)
    n, t = result.num_sequences, result.elapsed_seconds
    print(f"{steps:>5}  {loops:>5}  {result.mean_plddt:>8.4f}  {t:>9.1f}  "
          f"{n/t:>7.2f}  {t/n:>7.2f}  {peak_memory_gb(scorer.device):>8.1f}",
          flush=True)

print()
PYEOF

echo "[job] finished $(date '+%Y-%m-%dT%H:%M:%S%z')"
