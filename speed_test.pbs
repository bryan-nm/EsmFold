#!/bin/bash -l
#PBS -A NLDesignProtein
#PBS -N esmfold_speed_test
#PBS -l walltime=01:00:00
#PBS -l select=1
#PBS -l place=scatter
#PBS -l filesystems=home_fs:flare_fs
#PBS -q debug
#PBS -j oe
#PBS -M bryan.andrews.phd@gmail.com
#PBS -m be

# ---------------------------------------------------------------------------
# Speed test: score 100 SwissProt sequences at several step/loop configs.
# Single-node, single-tile inference — loads the model ONCE, then sweeps.
# ---------------------------------------------------------------------------

cd "${PBS_O_WORKDIR:?submit with qsub from the repo root}" || exit 1
set -eo pipefail

module load frameworks

# ---------------------------------------------------------------------------
# Environment — a dedicated venv layered on the frameworks module.
# To create it (once, from a login node):
#
#   module load frameworks
#   python -m venv /flare/NLDesignProtein/bryan/envs/esmfold-env --system-site-packages
#   source /flare/NLDesignProtein/bryan/envs/esmfold-env/bin/activate
#   pip install --ignore-installed 'transformers>=4.57'
#   pip install --no-deps 'esm @ git+https://github.com/Biohub/esm.git@main'
#   pip install biopython biotite cloudpathlib zstd msgpack-numpy pygtrie tenacity brotli
#
# --system-site-packages inherits torch, ipex and oneCCL from the frameworks
# module. --no-deps on esm stops it pulling a PyPI CUDA torch that would
# shadow the system XPU build. --ignore-installed on transformers forces a
# venv-local copy (pip would otherwise accept the older system version).
# ---------------------------------------------------------------------------
source /flare/NLDesignProtein/bryan/envs/esmfold-env/bin/activate

export ONEAPI_DEVICE_SELECTOR="level_zero:gpu"
export ZE_FLAT_DEVICE_HIERARCHY=FLAT
export HF_HUB_OFFLINE=1

# The frameworks module prepends its site-packages to PYTHONPATH, shadowing
# venv-installed packages. Put the venv's site-packages first.
VENV_SITE="$(python -c 'import sysconfig; print(sysconfig.get_path("purelib"))')"
export PYTHONPATH="${VENV_SITE}:${PBS_O_WORKDIR}/src${PYTHONPATH:+:$PYTHONPATH}"

# ---------------------------------------------------------------------------
# Paths — edit these if your layout differs
# ---------------------------------------------------------------------------
ESMFOLD_WEIGHTS="/flare/NLDesignProtein/bryan/models/ESMFold2-Fast"
FASTA="test_sequences.fasta"

# ---------------------------------------------------------------------------
# Banner
# ---------------------------------------------------------------------------
echo "================================================================"
echo "  ESMFold2-Fast speed test"
echo "================================================================"
echo "  job           : ${PBS_JOBID:-<interactive>}  ${PBS_JOBNAME:-}"
echo "  started       : $(date '+%Y-%m-%dT%H:%M:%S%z')"
echo "  user@host     : $(whoami)@$(hostname)"
echo "  repo          : $(pwd)"
echo "  weights       : ${ESMFOLD_WEIGHTS}"
echo "  HF_HUB_OFFLINE: ${HF_HUB_OFFLINE}"
echo "  fasta         : ${FASTA} ($(grep -c '^>' ${FASTA}) sequences)"
echo "  python        : $(which python)"
echo "  torch         : $(python -c 'import torch; print(torch.__version__)')"
echo "  ipex          : $(python -c 'import intel_extension_for_pytorch as x; print(x.__version__)' 2>/dev/null || echo 'not installed')"
echo "  transformers  : $(python -c 'import transformers; print(transformers.__version__)')"
echo "  esm           : $(python -c 'import esm; print(esm.__version__)' 2>/dev/null || echo 'not installed')"
echo "  xpu devices   : $(python -c 'import torch, intel_extension_for_pytorch; print(torch.xpu.device_count())' 2>/dev/null || echo 'N/A')"
echo "================================================================"
echo ""

# ---------------------------------------------------------------------------
# Run: load model once, sweep step/loop configs
# ---------------------------------------------------------------------------
python - "${ESMFOLD_WEIGHTS}" "${FASTA}" <<'PYEOF'
import sys
import time

import torch

from esmfold_scorer import StructureScorer
from esmfold_scorer.cli import parse_fasta
from esmfold_scorer.scorer import peak_memory_gb

model_path, fasta_path = sys.argv[1], sys.argv[2]

sequences = [seq for _, seq in parse_fasta(fasta_path)]
print(f"Loaded {len(sequences)} sequences "
      f"({min(map(len, sequences))}-{max(map(len, sequences))} aa)\n")

t_load = time.monotonic()
scorer = StructureScorer(model_path=model_path, device="xpu")
print(f"Model loaded in {time.monotonic() - t_load:.1f} s "
      f"({peak_memory_gb(scorer.device):.1f} GiB resident)\n")

# Smoke test on the memory worst case before committing to the full sweep.
longest = max(sequences, key=len)
print(f"[smoke] {len(longest)} aa ...", end=" ", flush=True)
t = time.monotonic()
smoke = scorer.score([longest], num_sampling_steps=20, num_loops=1)
print(f"OK  pLDDT={smoke.mean_plddt:.4f}  {time.monotonic() - t:.1f}s\n",
      flush=True)

# Step counts are clustered around 10-20: quality collapses somewhere in
# that range (0.26 -> 0.84) rather than degrading gradually, and the exact
# cliff location sets how much headroom the 20-step default really has.
configs = [(n, 1) for n in (5, 10, 12, 14, 16, 18, 20, 25, 50)]
configs += [(20, 3), (50, 3)]  # confirm recycling loops still don't matter

print(f"{'steps':>5}  {'loops':>5}  {'pLDDT':>8}  {'pTM':>7}  "
      f"{'time (s)':>9}  {'seq/s':>7}  {'s/seq':>7}  {'peak GiB':>8}")
print("-" * 78)

for steps, loops in configs:
    torch.xpu.reset_peak_memory_stats()
    r = scorer.score(sequences, num_sampling_steps=steps, num_loops=loops)
    mean_ptm = sum(r.per_sequence_ptm) / r.num_sequences
    print(f"{steps:>5}  {loops:>5}  {r.mean_plddt:>8.4f}  {mean_ptm:>7.4f}  "
          f"{r.elapsed_seconds:>9.1f}  {r.num_sequences / r.elapsed_seconds:>7.2f}  "
          f"{r.elapsed_seconds / r.num_sequences:>7.2f}  "
          f"{peak_memory_gb(scorer.device):>8.1f}", flush=True)

print()
PYEOF

echo "[job] finished $(date '+%Y-%m-%dT%H:%M:%S%z')"
